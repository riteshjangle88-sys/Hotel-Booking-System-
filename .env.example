# ===================================================================
# Vedic Stay Hotel Booking Management System - Environment Variables
# ===================================================================
# Copy this file to .env and customize values for your deployment.
# Never commit actual credentials or secrets to version control.

# Flask Application Secret Key
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_DEBUG=1

# Server Configuration
HOST=127.0.0.1
PORT=5000
